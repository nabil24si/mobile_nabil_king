<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@drawable/bg">

    <ImageView
        android:id="@+id/ivTutorial2"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_persil_lahan" /> <TextView
    android:id="@+id/tvTitle2"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="40dp"
    android:text="Manajemen Data Persil Lahan"
    android:textAlignment="center"
    android:textColor="#0F766E"
    android:textSize="22sp"
    android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDesc2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Pantau informasi kepemilikan data persil, luas wilayah, penggunaan lahan, hingga zonasi blok desa secara transparan dan akurat."
        android:textAlignment="center"
        android:textColor="#64748B"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.2" />

</LinearLayout>