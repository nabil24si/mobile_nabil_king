<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@drawable/bg">

    <ImageView
        android:id="@+id/ivTutorial1"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_welcome_desa" />
    <TextView
    android:id="@+id/tvTitle1"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="40dp"
    android:text="Selamat Datang di Bina Desa"
    android:textAlignment="center"
    android:textColor="#0F766E"
    android:textSize="22sp"
    android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDesc1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Wujudkan desa yang mandiri, produktif, dan serba digital dengan ekosistem administrasi pintar dalam satu genggaman."
        android:textAlignment="center"
        android:textColor="#64748B"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.2" />

</LinearLayout>